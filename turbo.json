{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": true
    },
    "lint-fix": {
      "cache": true
    },
    "format": {
      "cache": true
    },
    "format-fix": {
      "cache": true
    }
  }
}
