---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/head.astro";
import Footer from "../components/footer.astro";
import FormattedDate from "../components/formatted-date.astro";
import Navbar from "@/components/navbar/navbar.astro";
import Container from "@/components/container/container.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, date, updated_date, image } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Navbar variant="light" />

		<Container>
			<div class="prose md:mx-auto prose-img:rounded-2xl">
				<div class="mb-4 py-4 text-center">
					<div class="date">
						{
							updated_date && (
								<div class="last-updated-on">
									Last updated on{" "}
									<FormattedDate date={updated_date} />
								</div>
							)
						}
						<FormattedDate date={date} />
					</div>

					<h1>{title}</h1>

					<div class="w-full">
						{
							image && (
								<Image
									class="block mx-auto"
									width={1020}
									height={510}
									src={image}
									alt=""
								/>
							)
						}
					</div>
				</div>

				<slot />
			</div>
		</Container>

		<Footer />
	</body>
</html>
